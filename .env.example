PORT=4100
API_KEY=change-me
MONGO_URI=mongodb://localhost:27017/automation
TRADE_FLOW_USER_ID=
REDIS_URL=redis://127.0.0.1:6376
CHROME_PATH=
HEADLESS=false
SLOW_MO_MS=200
KEEP_BROWSER_OPEN_MS=60000
WORKER_CONCURRENCY=1
FETCH_WINDOW_CONCURRENCY=0
# Bearer token the Android SMS forwarder sends to POST /api/sms/receive (empty = webhook off)
SMS_API_TOKEN=
# Payment budget (ms), counted from the moment Pay is pressed on Flipkart's card form:
# hand-off, bank identity step and the OTP arriving must all fit in it. Default 2 min.
OTP_TIMEOUT_MS=120000
# How long a leased OTP handset stays held by a run that has gone quiet (ms). Default 2 min.
OTP_LEASE_TTL_MS=120000

# --- checkout browser contexts ---
# Flipkart serves two different sites and picks by User-Agent. FlipkartCheckout is
# m-site automation (#msite-bottomsheet, touchscreen.tap), so the cart -> checkout
# leg must run in mobile emulation or its selectors do not exist.
MOBILE_DEVICE=Pixel 7

# --- test harness ---
# 1 enables /api/test/* and the dashboard Test tab. Off by default: the harness
# drives real Flipkart pages, so it should not be reachable by accident.
ENABLE_TEST_ROUTES=0
TEST_ARTIFACT_DIR=debug/test-runs

# true = card jobs stop at the payment page (no bank, no charge); false = pay for real
PAYMENT_DRY_RUN=true

# --- worker classes ---
# Which queues this worker process serves (otp-phone, card, cod); default all.
WORKER_CLASSES=otp-phone,card,cod
# Jobs at once per class (each job is two Chromes, ~0.5 GB). Overrides WORKER_CONCURRENCY.
WORKER_CONCURRENCY_OTP_PHONE=1
WORKER_CONCURRENCY_CARD=1
WORKER_CONCURRENCY_COD=1
# How long an otp-phone job waits before asking again when no handset is free (ms).
PHONE_WAIT_MS=20000

# --- egress (Proxy Pool, managed in the dashboard's Proxy Pool tab) ---
# This process's identity in the pool; its proxy binding is keyed on it and
# survives restarts. One per AWS task (w-001 …). Default: the machine hostname.
WORKER_ID=
# required  = no proxy -> the worker exits and takes no jobs
# preferred = use a proxy when one is free, else the local connection (default)
# off       = ignore the pool
PROXY_MODE=preferred
# Decrypts proxy passwords. MUST equal the dashboard backend's PROXY_CRED_KEY.
PROXY_CRED_KEY=
# required mode: how long a job waits for a proxy to free up before asking again (ms).
PROXY_WAIT_MS=30000
# Consecutive failures before a proxy is marked dead.
PROXY_DEAD_AFTER=3

# --- order fetch / update ---
# FALLBACK only: the dashboard's Scrape/API switch (sync panel) overrides this
# per workspace, with no restart. scrape = pages in Chrome (default)
# api    = Flipkart's own order APIs with the saved session; no Chrome unless a
#          unit falls back to the page. Verify first with the Test tab's
#          "Fetch & update via API" panel.
ORDER_FETCH_MODE=scrape
# Replayable trace of every real fetch/update run (raw API responses or page
# snapshots + mapped docs + the invariant line). Empty = off. Holds real order
# data — keep it under debug/ (gitignored). Replay: npm run orders:replay -- <runDir>
ORDER_TRACE_DIR=

# --- invoices ---
# Private S3 bucket for invoice PDFs, keyed invoices/<user>/<order date>/<order id>.pdf.
# Same bucket as the dashboard. Credentials from the standard AWS chain (never here).
# Empty = the invoice step is off whatever the dashboard asks for.
INVOICE_S3_BUCKET=
AWS_REGION=ap-south-1
# Most invoices one account captures per run in "missing" mode.
INVOICE_MAX_PER_RUN=200
# "Download Order Invoices" by order id as a batch (services/invoiceRequests.ts, queue order-invoice-batch):
# accounts downloaded in parallel — one order is ≈1.7 s of work, so 12 lanes ≈ 0.17 s per order.
INVOICE_BATCH_CONCURRENCY=12
# Pause between two orders of one account (ms).
INVOICE_BATCH_PAUSE_MS=250
# Every download keeps Flipkart's own files untouched at orig/<user>/<order>/<sha256>.pdf (written once, the
# other Mac writing the same bytes is a no-op) and records the download in Mongo `invoice_downloads`; the merged
# raw/<user>/<order>.pdf stays the extractor's input (docs/invoice-originals.md). No setting: the same bucket.
# Writing orig/* needs the Writer policy's orig/* grant, which comes with D1 (dashboard sub-step 5 deploy). Without
# it the originals are skipped (best-effort, logged "[invoice-originals] … not kept") and every download still works.
# The six rules below (INVOICE_SETTLE_HOURS, INVOICE_RECAPTURE_GIVE_UP_DAYS, INVOICE_REFETCH_CANCEL_DELAY_H,
# INVOICE_REFETCH_REFUND_DELAY_H, INVOICE_REFETCH_COD_DELAY_H, INVOICE_CAPTURE_CANCELLED) are only FALLBACKS now: a
# value saved in the dashboard, Settings -> Invoice settings (Mongo `invoice_settings`, one row per workspace, shared
# by every machine), wins over this file, and a field not saved there follows this file, then the default
# (services/invoiceSettings.ts). A worker on this code reads a saved change within 30 s, with no restart. The
# cancelled-after-shipping switch is SEEDED ON in the database at the first API / worker start, so
# INVOICE_CAPTURE_CANCELLED below no longer turns it off -- switch it off in Settings -> Invoice settings.
# A bundle is final ("settled") once every unit of the order is finished and the last delivery is this many
# hours old; a bundle not final yet is downloaded again by the 3-hourly sweep this many hours after its capture,
# and again until it is (at most INVOICE_RECAPTURE_GIVE_UP_DAYS after its row was made). Default 48.
INVOICE_SETTLE_HOURS=48
# A bundle still not final (an order stuck "on its way") this many days after its row was made is settled anyway,
# so the sweep stops re-downloading it every window. Not in the plan's specs (sub-step 12 added it with T2's
# repeat-until-delivered look) — the owner may change it. Default 30.
INVOICE_RECAPTURE_GIVE_UP_DAYS=30
# Late re-downloads (data-quality SO-5, services/invoiceRefetch.ts): when an invoiced unit of a stored bundle turns
# Cancelled / Returned, or its refund completes, the order is downloaded once more by the 3-hourly sweep's third
# phase ("refetch"), this many hours after that moment, to pick up the credit notes Flipkart issues later. These are
# owner question 4 of the plan, still open: the defaults are the plan's recommendation — the cancellation (or
# return) look 1 day after it (product / fee credit notes), the refund look 8 days after the refund (the freight
# credit note, 4–8 days after it), and for cash on delivery (no refund follows) the cancellation look 8 days after
# the cancellation. Set the same values on both Macs: whoever notes the moment computes its due time.
INVOICE_REFETCH_CANCEL_DELAY_H=24
INVOICE_REFETCH_REFUND_DELAY_H=192
INVOICE_REFETCH_COD_DELAY_H=192
# 1 = the sweep's phase 1 also downloads orders cancelled after shipping that have no stored invoice, once their last
# cancellation is 15 days old (SO-6; ~2,500 such orders when this was written). 0 (the code default) = off. FALLBACK
# ONLY: the switch is seeded ON in Settings -> Invoice settings, which wins over this line; with it ON the backlog
# drains at most INVOICE_MAX_PER_RUN per 3-hourly sweep, shared with delivered orders in phase 1. Either way phase 1 remembers failures on Flipkart's side: an
# order whose download Flipkart failed is not tried again for 24 h, and never after 3 such failures
# (invoice_capture_failures on its units; a later capture clears it). Our own S3 / Mongo failures are not counted.
INVOICE_CAPTURE_CANCELLED=0

# --- company coupons (services/couponRequests.ts, queue order-coupon-apply) ---
# 1 = "Apply Company Coupons" is offered; 0 = the trigger answers 503. Each coupon link is opened with each
# account's saved session over plain HTTP and what Flipkart answers is recorded — whether that alone
# ACTIVATES a coupon is unverified until a real coupon link has been tried.
COMPANY_COUPONS_ENABLED=1
# Accounts worked at once, the pause between two links of one account (ms), and after an account (ms).
COUPON_CONCURRENCY=4
COUPON_LINK_PAUSE_MS=1500
COUPON_ACCOUNT_PAUSE_MS=500

# An invoice / coupon request no worker has taken after this long, with no worker listening on its
# queue, is failed with "The worker has not picked this up — restart the worker" (ms).
REQUEST_PICKUP_MS=180000

# --- schedules (docs/schedules.md) ---
# The four schedules — nightly fetch (05:00), update of all active units (every 6 h), out-for-delivery recheck
# (every 2 h), invoice sweep (every 3 h) — are switched ON and OFF in the dashboard: Settings → Scheduled fetch.
# The switches and the times live in the database and are shared by every machine; one machine runs each time and
# another takes over when it is away. The lines below do NOT switch a schedule on or off. They only say whether
# THIS machine may be the one that runs it:
#   UPDATE_SCHEDULE=0    this machine never runs the two update sweeps   (line missing, or 1 = it may)
#   INVOICE_SCHEDULE=0   this machine never runs the invoice sweep       (line missing, or 1 = it may) — set it on a
#                        machine without INVOICE_S3_BUCKET: such a machine could only skip a time it took
#   FETCH_SCHEDULE=0     this machine never runs the nightly fetch — also when the line is missing
#                        (1, or a time such as "0 5 * * *" = it may)
# The Update, Fetch and Invoices buttons work whatever these say.
UPDATE_SCHEDULE=1
INVOICE_SCHEDULE=1
FETCH_SCHEDULE=0 5 * * *
# Read ONCE — by the first Trade Flow start on a workspace, which creates the four clocks — and never again:
# the time in FETCH_SCHEDULE ("M H * * *"; anything else = 05:00), CRON_TIMEZONE (Asia/Kolkata or UTC),
# UPDATE_SWEEP_MS, UPDATE_OFD_SWEEP_MS and INVOICE_SWEEP_MS (the periods: 6 h, 2 h, 3 h; the fixed times are :15,
# :45 and :35 past). Changing them afterwards does nothing: the clocks are in order_schedule_leases. That first
# start also writes each sweep's switch as this machine has it above; the nightly fetch always starts OFF.
#
# This machine as the schedules, the request log and the reapers name it. Give every machine its own pair: two
# machines under one TRADEFLOW_SYSTEM_ID count as one machine — neither would take over from the other.
# Empty = the machine's hostname.
TRADEFLOW_SYSTEM_ID=
TRADEFLOW_HOST_ID=

UPDATE_CONCURRENCY=3

# Look-back for the scheduled fetch when the dashboard has not set fetchSinceDays
FETCH_SINCE_DAYS=60
# Scheduled fetch also downloads invoices ("all missing") — default for the dashboard Settings toggle; the toggle wins once set
FETCH_SCHEDULE_INVOICES=0

# Reschedule Order Units (services/orderReschedule.ts)
# RESCHEDULE_CONFIRM=1 lets the worker press Flipkart's confirm after choosing the date; off = capture the
# dialog only and mark the unit needs_review (until the date dialog has been verified on a real unit)
RESCHEDULE_CONFIRM=0
# accounts rescheduled in parallel (one Chrome each)
RESCHEDULE_CONCURRENCY=1

# HTTP checkout engine (orders submitted as "High Speed", COD): Flipkart's own API
# calls, no Chrome per job — see docs/http-checkout.md. Jobs sit on the checkout-http
# queue; this many run at once in this process (0 = this process takes none).
HTTP_CHECKOUT_CONCURRENCY=25
# An HTTP job the engine hands back ("fallback") runs the Chrome flow in this same
# process; at most this many of those at once (RAM: two Chromes each).
HTTP_FALLBACK_CHROME_MAX=2
