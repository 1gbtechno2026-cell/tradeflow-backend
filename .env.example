PORT=4100
API_KEY=change-me
MONGO_URI=mongodb://localhost:27017/automation
TRADE_FLOW_USER_ID=
REDIS_URL=redis://127.0.0.1:6376
CHROME_PATH=
HEADLESS=false
SLOW_MO_MS=200
KEEP_BROWSER_OPEN_MS=60000
WORKER_CONCURRENCY=1
FETCH_WINDOW_CONCURRENCY=0
# Bearer token the Android SMS forwarder sends to POST /api/sms/receive (empty = webhook off)
SMS_API_TOKEN=

# --- checkout browser contexts ---
# Flipkart serves two different sites and picks by User-Agent. FlipkartCheckout is
# m-site automation (#msite-bottomsheet, touchscreen.tap), so the cart -> checkout
# leg must run in mobile emulation or its selectors do not exist.
MOBILE_DEVICE=Pixel 7

# --- test harness ---
# 1 enables /api/test/* and the dashboard Test tab. Off by default: the harness
# drives real Flipkart pages, so it should not be reachable by accident.
ENABLE_TEST_ROUTES=0
TEST_ARTIFACT_DIR=debug/test-runs
