PORT=4100
API_KEY=change-me
MONGO_URI=mongodb://localhost:27017/automation
TRADE_FLOW_USER_ID=
REDIS_URL=redis://127.0.0.1:6376
CHROME_PATH=
HEADLESS=false
SLOW_MO_MS=200
KEEP_BROWSER_OPEN_MS=60000
WORKER_CONCURRENCY=1
FETCH_WINDOW_CONCURRENCY=0
# Bearer token the Android SMS forwarder sends to POST /api/sms/receive (empty = webhook off)
SMS_API_TOKEN=
# Payment budget (ms), counted from the moment Pay is pressed on Flipkart's card form:
# hand-off, bank identity step and the OTP arriving must all fit in it. Default 2 min.
OTP_TIMEOUT_MS=120000
# How long a leased OTP handset stays held by a run that has gone quiet (ms). Default 2 min.
OTP_LEASE_TTL_MS=120000

# --- checkout browser contexts ---
# Flipkart serves two different sites and picks by User-Agent. FlipkartCheckout is
# m-site automation (#msite-bottomsheet, touchscreen.tap), so the cart -> checkout
# leg must run in mobile emulation or its selectors do not exist.
MOBILE_DEVICE=Pixel 7

# --- test harness ---
# 1 enables /api/test/* and the dashboard Test tab. Off by default: the harness
# drives real Flipkart pages, so it should not be reachable by accident.
ENABLE_TEST_ROUTES=0
TEST_ARTIFACT_DIR=debug/test-runs

# true = card jobs stop at the payment page (no bank, no charge); false = pay for real
PAYMENT_DRY_RUN=true

# --- worker classes ---
# Which queues this worker process serves (otp-phone, card, cod); default all.
WORKER_CLASSES=otp-phone,card,cod
# Jobs at once per class (each job is two Chromes, ~0.5 GB). Overrides WORKER_CONCURRENCY.
WORKER_CONCURRENCY_OTP_PHONE=1
WORKER_CONCURRENCY_CARD=1
WORKER_CONCURRENCY_COD=1
# How long an otp-phone job waits before asking again when no handset is free (ms).
PHONE_WAIT_MS=20000

# --- egress (Proxy Pool, managed in the dashboard's Proxy Pool tab) ---
# This process's identity in the pool; its proxy binding is keyed on it and
# survives restarts. One per AWS task (w-001 …). Default: the machine hostname.
WORKER_ID=
# required  = no proxy -> the worker exits and takes no jobs
# preferred = use a proxy when one is free, else the local connection (default)
# off       = ignore the pool
PROXY_MODE=preferred
# Decrypts proxy passwords. MUST equal the dashboard backend's PROXY_CRED_KEY.
PROXY_CRED_KEY=
# required mode: how long a job waits for a proxy to free up before asking again (ms).
PROXY_WAIT_MS=30000
# Consecutive failures before a proxy is marked dead.
PROXY_DEAD_AFTER=3

# --- order fetch / update ---
# FALLBACK only: the dashboard's Scrape/API switch (sync panel) overrides this
# per workspace, with no restart. scrape = pages in Chrome (default)
# api    = Flipkart's own order APIs with the saved session; no Chrome unless a
#          unit falls back to the page. Verify first with the Test tab's
#          "Fetch & update via API" panel.
ORDER_FETCH_MODE=scrape
# Replayable trace of every real fetch/update run (raw API responses or page
# snapshots + mapped docs + the invariant line). Empty = off. Holds real order
# data — keep it under debug/ (gitignored). Replay: npm run orders:replay -- <runDir>
ORDER_TRACE_DIR=
