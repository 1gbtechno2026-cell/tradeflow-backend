# Trade Flow — LOCAL profile (your Mac). Copy to .env.
TRADEFLOW_ENV=local
PORT=4100
API_KEY=change-me
MONGO_URI=
TRADE_FLOW_USER_ID=
REDIS_URL=redis://127.0.0.1:6376
HEADLESS=false
SLOW_MO_MS=0
KEEP_BROWSER_OPEN_MS=0
WORKER_ROLES=checkout,cancel,sync,update,reschedule
WORKER_CONCURRENCY=1
CANCEL_CONCURRENCY=1
RESCHEDULE_CONCURRENCY=1
FETCH_WINDOW_CONCURRENCY=0
ORDER_FETCH_MODE=api
# Proxy: the dashboard's Settings → Environments switch wins once set; this is the fallback for "local"
PROXY_MODE=off
PROXY_LEASE=session
PROXY_REST_MS=60000
PROXY_CRED_KEY=
# Schedules stay off while developing (Update button / Fetch button only)
UPDATE_SCHEDULE=0
FETCH_SCHEDULE=0
FETCH_SINCE_DAYS=60
FETCH_SCHEDULE_INVOICES=0
RESCHEDULE_CONFIRM=0
INVOICE_S3_BUCKET=
AWS_REGION=ap-south-1
QUEUE_METRICS=0
