# Trade Flow — LOCAL profile (your Mac). Copy to .env.
TRADEFLOW_ENV=local
PORT=4100
API_KEY=change-me
MONGO_URI=
TRADE_FLOW_USER_ID=
REDIS_URL=redis://127.0.0.1:6376
HEADLESS=false
SLOW_MO_MS=0
KEEP_BROWSER_OPEN_MS=0
WORKER_ROLES=checkout,cancel,sync,update,reschedule,invoice,invoice-batch,coupon
WORKER_CONCURRENCY=1
CANCEL_CONCURRENCY=1
RESCHEDULE_CONCURRENCY=1
FETCH_WINDOW_CONCURRENCY=0
ORDER_FETCH_MODE=api
# Proxy: the dashboard's Settings → Environments switch wins once set; this is the fallback for "local"
PROXY_MODE=off
PROXY_LEASE=session
PROXY_REST_MS=60000
PROXY_CRED_KEY=
# Schedules: 0 = THIS machine never runs them — the update sweeps and the nightly fetch below. It does not switch
# them off for any other machine: the switches are in the dashboard (Settings → Scheduled fetch) and are shared.
# The Update and Fetch buttons work as always. The invoice sweep may run here unless you add INVOICE_SCHEDULE=0,
# which a machine without INVOICE_S3_BUCKET should (docs/schedules.md).
UPDATE_SCHEDULE=0
FETCH_SCHEDULE=0
FETCH_SINCE_DAYS=60
FETCH_SCHEDULE_INVOICES=0
RESCHEDULE_CONFIRM=0
# true = stop at the payment page and record dry_run (nothing placed). Anything else = real orders.
PAYMENT_DRY_RUN=false
INVOICE_S3_BUCKET=
AWS_REGION=ap-south-1
QUEUE_METRICS=0
