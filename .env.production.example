# Trade Flow — PRODUCTION profile (ECS tasks / the EC2 ops box). Values with "secret:" come from
# Secrets Manager tradeflow/<env>/app (the fleet stack injects them); the rest are plain env.
TRADEFLOW_ENV=production
PORT=4100
API_KEY=secret:API_KEY
MONGO_URI=secret:MONGO_URI
TRADE_FLOW_USER_ID=secret:TRADE_FLOW_USER_ID
PROXY_CRED_KEY=secret:PROXY_CRED_KEY
SMS_API_TOKEN=secret:SMS_API_TOKEN
REDIS_URL=redis://<elasticache endpoint>:6379/0
HEADLESS=true
SLOW_MO_MS=0
KEEP_BROWSER_OPEN_MS=0
# Chrome worker container: WORKER_ROLES=checkout  WORKER_CONCURRENCY=8  (set by the task definition)
# cancel container:        WORKER_ROLES=cancel,reschedule  CANCEL_CONCURRENCY=2
# ops box:                 WORKER_ROLES=sync,update        SYNC_CONCURRENCY=4
WORKER_CLASSES=cod
ORDER_FETCH_MODE=api
FETCH_WINDOW_CONCURRENCY=3
# Proxy: the dashboard switch wins; fallback for "production" is required, one proxy per Chrome session
PROXY_MODE=required
PROXY_LEASE=session
PROXY_REST_MS=60000
# Production schedules on (API / ops box only)
UPDATE_SCHEDULE=1
FETCH_SCHEDULE=0 5 * * *
FETCH_SINCE_DAYS=60
FETCH_SCHEDULE_INVOICES=1
RESCHEDULE_CONFIRM=0
# true = stop at the payment page and record dry_run (nothing placed). Anything else = real orders.
PAYMENT_DRY_RUN=false
INVOICE_S3_BUCKET=tradeflow-invoices-515927224223
AWS_REGION=ap-south-1
QUEUE_METRICS=1
QUEUE_METRICS_ENV=prod
