{
  "name": "trade-flow-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "postinstall": "npm run build",
    "start": "node dist/index.js",
    "worker": "tsx src/worker.ts",
    "worker:prod": "node dist/worker.js",
    "up": "concurrently -k -r -n api,worker -c blue,magenta \"npm:dev\" \"npm:worker\"",
    "up:prod": "npm run build && concurrently -k -r -n api,worker -c blue,magenta \"npm:start\" \"npm:worker:prod\"",
    "typecheck": "tsc --noEmit",
    "test:otp": "tsx src/scripts/otpParseTest.ts",
    "test:flow": "tsx src/scripts/testFlowCli.ts",
    "test:card-http": "tsx src/scripts/cardHttpTest.ts",
    "test:cancel": "tsx src/scripts/cancelTestCli.ts",
    "test:otp-plumbing": "tsx src/scripts/otpPlumbingTest.ts",
    "backfill:order-ids": "tsx src/scripts/backfillOrderIds.ts",
    "batches:backfill": "tsx src/scripts/backfillBatchCounters.ts",
    "test:classify": "tsx src/scripts/classifyTest.ts",
    "test:proxy-pool": "tsx src/scripts/proxyPoolTest.ts",
    "orders:replay": "tsx src/scripts/replayOrderTrace.ts",
    "orders:resync-recent": "tsx src/scripts/resyncRecent.ts",
    "orders:reconcile-dropped": "tsx src/scripts/reconcileDropped.ts",
    "bench:http": "tsx src/scripts/httpCheckoutBench.ts",
    "orders:api-bench": "tsx src/scripts/orderApiBench.ts",
    "orders:backfill-cancelled-by": "tsx src/scripts/backfillCancelledBy.ts",
    "orders:unit-backfill": "tsx src/scripts/unitDataBackfill.ts",
    "invoices:originals-backfill": "tsx src/scripts/invoiceOriginalsBackfill.ts",
    "test:unit-save": "tsx src/scripts/unitSaveCheck.ts",
    "test:unit-mapper": "tsx src/scripts/unitMapperCheck.ts",
    "test:refund-card": "tsx src/scripts/refundCardSaveCheck.ts",
    "test:start-requests": "tsx src/scripts/startRequestsCheck.ts",
    "test:invoice-batch": "tsx src/scripts/invoiceBatchCheck.ts",
    "test:invoice-originals": "tsx src/scripts/invoiceOriginalsCheck.ts",
    "test:invoice-refetch": "tsx src/scripts/invoiceRefetchCheck.ts",
    "test:coupons": "tsx src/scripts/couponRunnerCheck.ts",
    "test:request-log": "tsx src/scripts/requestLogCheck.ts",
    "test:request-actions": "tsx src/scripts/requestActionsCheck.ts",
    "request-log:backfill": "tsx src/scripts/requestLogBackfill.ts",
    "test:dead-session": "tsx src/scripts/deadSessionCheck.ts",
    "test:dead-session-flows": "tsx src/scripts/deadSessionFlowsCheck.ts",
    "test:dead-session-checkout": "tsx src/scripts/deadSessionCheckoutCheck.ts",
    "test:schedule-lease": "tsx src/scripts/scheduleLeaseCheck.ts",
    "test:schedule-sweep": "tsx src/scripts/scheduleSweepCheck.ts",
    "test:fetch-schedule": "tsx src/scripts/fetchScheduleCheck.ts",
    "schedules:seed": "tsx src/scripts/scheduleSeed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "^3.1156.0",
    "@aws-sdk/client-s3": "^3.1151.0",
    "bullmq": "^5.58.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "fflate": "0.8.3",
    "ioredis": "^5.7.0",
    "mongoose": "^8.16.0",
    "node-cron": "^4.2.1",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.4",
    "playwright": "1.63.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "tsx": "4.20.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.16.5",
    "@types/node-cron": "^3.0.11",
    "concurrently": "^10.0.7",
    "typescript": "^5.8.3"
  }
}
